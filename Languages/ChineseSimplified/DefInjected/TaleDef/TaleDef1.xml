<?xml version='1.0' encoding='UTF-8'?>
<LanguageData>
  <!--EN: participated in archotech awakening-->
  <GR_Transcended.label>参与archotech觉醒</GR_Transcended.label>
  <GR_Transcended.rulePack.rulesStrings>
    <!--EN: tale_noun->[PAWN_nameDef] participating in the archotech awakening-->
    <li>tale_noun-&gt;[PAWN_nameDef]参与考古科技觉醒</li>
    <!--EN: image->[PAWN_nameFull] toggling on the archotech AI [circumstance_group]-->
    <li>image-&gt;[PAWN_nameFull] 切换 archotech AI [circumstance_group]</li>
    <!--EN: image->[PAWN_nameFull] trembling in fear of the archotech AI [circumstance_group]-->
    <li>image-&gt;[PAWN_nameFull]因害怕Archotech AI而颤抖[circumstance_group]</li>
    <!--EN: image->[PAWN_nameFull] looking with unease at the archotech AI [circumstance_group]-->
    <li>image-&gt;[PAWN_nameFull] 不安地看着 archotech AI [circumstance_group]</li>
    <!--EN: image->[PAWN_nameFull] checking the integrity of the archotech project [circumstance_group]-->
    <li>image-&gt;[PAWN_nameFull]检查 archotech 项目的完整性 [circumstance_group]</li>
    <!--EN: circumstance_phrase->in front of a [TerrainFeature]-->
    <li>circumstance_phrase-&gt;在 [TerrainFeature] 前面</li>
    <!--EN: circumstance_phrase->with incredible intelligence-->
    <li>circumstance_phrase-&gt;具有令人难以置信的智慧</li>
    <!--EN: circumstance_phrase->in a lab coat-->
    <li>circumstance_phrase-&gt;穿着实验室外套</li>
    <!--EN: circumstance_phrase->with electricity coiling dramatically-->
    <li>circumstance_phrase-&gt;电力急剧卷绕</li>
    <!--EN: circumstance_phrase->cackling madly-->
    <li>circumstance_phrase-&gt;疯狂地咯咯笑</li>
    <!--EN: desc_sentence->[PAWN_pronoun] is concentrating intently on the controls.-->
    <li>desc_sentence-&gt;[PAWN_pronoun] 专注于控件。</li>
    <!--EN: desc_sentence->[PAWN_pronoun] has [PAWN_possessive] eyes slanted and looks confident.-->
    <li>desc_sentence-&gt;[PAWN_pronoun] [PAWN_possessive] 眼睛倾斜，看起来很自信。</li>
    <!--EN: desc_sentence->[PAWN_pronoun] is fidgeting, [PAWN_possessive] eyes open wide.-->
    <li>desc_sentence-&gt;[PAWN_pronoun]坐立不安，[PAWN_possessive]眼睛睁得大大的。</li>
    <!--EN: desc_sentence->[PAWN_pronoun] is smiling with grim joy.-->
    <li>desc_sentence-&gt;[PAWN_pronoun] 带着冷酷的喜悦微笑。</li>
    <!--EN: desc_sentence->[PAWN_pronoun] seems to be fully in control of the situation (but reaaaally isn't).-->
    <li>desc_sentence-&gt;[PAWN_pronoun] 似乎完全控制了局势（但实际上并非如此）。</li>
    <!--EN: desc_sentence->There is a trace of ozone in the air.-->
    <li>desc_sentence-&gt;空气中存在微量臭氧。</li>
    <!--EN: desc_sentence->A nearby [Animal] is looking up, startled.-->
    <li>desc_sentence-&gt;附近的一个[Animal]正在抬起头，惊讶不已。</li>
    <!--EN: desc_sentence->A [Animal] is fleeing the lab in fear.-->
    <li>desc_sentence-&gt;一个[Animal]因恐惧而逃离实验室。</li>
    <!--EN: desc_sentence->There is a [TerrainFeature] in the background.-->
    <li>desc_sentence-&gt;背景中有一个[TerrainFeature]。</li>
    <!--EN: desc_sentence->A [PersonJob] watches silently from afar, fearing for his future.-->
    <li>desc_sentence-&gt;A [PersonJob] 默默地远远地看着，为自己的未来感到担忧。</li>
  </GR_Transcended.rulePack.rulesStrings>
</LanguageData>
