  <VBE_Cider.ingestible.ingestCommandString>喝{0}</VBE_Cider.ingestible.ingestCommandString>
  <!--EN: Drinking {0}.-->
  <VBE_Cider.ingestible.ingestReportString>饮酒 {0}。</VBE_Cider.ingestible.ingestReportString>
  <!--EN: cider-->
  <VBE_Cider.label>苹果酒</VBE_Cider.label>
  <!--EN: Unfermented cider with a starter in an air-tight bottle. If left alone to develop the proper bacteria the end result will be a weak alcoholic beverage.-->
  <VBE_UnfermentedCider.description>未发酵的苹果酒，配有发酵剂，装在密封瓶中。如果不去培养适当的细菌，最终的结果将是一种淡酒精饮料。</VBE_UnfermentedCider.description>
  <!--EN: unfermented cider-->
  <VBE_UnfermentedCider.label>未发酵的苹果酒</VBE_UnfermentedCider.label>
