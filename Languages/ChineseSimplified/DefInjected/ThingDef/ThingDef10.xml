  <VBE_Kombucha.ingestible.ingestReportString>饮酒 {0}。</VBE_Kombucha.ingestible.ingestReportString>
  <!--EN: kombucha tea-->
  <VBE_Kombucha.label>康普茶</VBE_Kombucha.label>
  <!--EN: Potent espresso mixed with fresh milk to help ease bitterness before pouring and serving. Lattes have a reputation of being particularly meant for “sophisticated” individuals.-->
