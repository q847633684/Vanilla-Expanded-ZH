    <!--EN: information->information-->
    <li>information-&gt;信息</li>
    <!--EN: information->knowledge-->
    <li>information-&gt;技术知识</li>
    <!--EN: information->intelligence-->
    <li>information-&gt;情报</li>
  </VFEA_InterrogatePrisoner.logRulesInitiator.rulesStrings>
  <!--EN: try to intimidate-->
  <VFEA_Intimidate.label>试图恐吓</VFEA_Intimidate.label>
