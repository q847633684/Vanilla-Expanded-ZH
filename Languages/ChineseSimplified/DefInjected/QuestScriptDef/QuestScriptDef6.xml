    <!--EN: questName->[asker_nameDef] and the Caravan [raid]-->
    <li>questName-&gt;[asker_nameDef] 和商队 [raid]</li>
    <!--EN: raid->Raid-->
    <li>raid-&gt;突袭</li>
    <!--EN: raid->Attack-->
    <li>raid-&gt;攻击</li>
    <!--EN: raid->Ambush-->
    <li>raid-&gt;伏击</li>
  </VFES_CaravanRaid.questNameRules.rulesStrings>
