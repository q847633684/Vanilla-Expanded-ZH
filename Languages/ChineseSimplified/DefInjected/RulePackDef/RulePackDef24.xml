<LanguageData>
  <VTE_BadEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a bad earnings report. Price is expected to move down.-->
    <li>root-&gt;[COMPANY] 发布了一份糟糕的收益报告。预计价格将下跌。</li>
  </VTE_BadEarnings.rulePack.rulesStrings>
  <VTE_BelowAverageEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a below average earnings report. Price is expected to drop slightly.-->
    <li>root-&gt;[COMPANY] 发布了低于平均水平的收益报告。预计价格将小幅下跌。</li>
  </VTE_BelowAverageEarnings.rulePack.rulesStrings>
  <VTE_CompanyDecline.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has reported budget cuts. Share price is bound to decrease in the long term.-->
    <li>root-&gt;[COMPANY] 报告了预算削减。从长远来看，股价必然会下跌。</li>
  </VTE_CompanyDecline.rulePack.rulesStrings>
  <VTE_CompanyGrowth.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has reported steady growth. Share price is bound to increase in the long term.-->
    <li>root-&gt;[COMPANY] 报告稳定增长。从长远来看，股价绑定将会上涨。</li>
  </VTE_CompanyGrowth.rulePack.rulesStrings>
  <VTE_DecentEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a decent earnings report. Price is expected to move slightly up.-->
    <li>root-&gt;[COMPANY] 发布了一份不错的收益报告。预计价格将小幅上涨。</li>
  </VTE_DecentEarnings.rulePack.rulesStrings>
  <VTE_ExcellentEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted an excellent earnings report. Price is expected to jump up.-->
    <li>root-&gt;[COMPANY] 发布了一份出色的收益报告。预计价格将上涨。</li>
  </VTE_ExcellentEarnings.rulePack.rulesStrings>
  <VTE_FactionInfestationLoot.rulePack.rulesStrings>
    <!--EN: root->[FACTION_name] has finally dealt with their infestations and decided to sell their excess jelly.-->
    <li>root-&gt;[FACTION_name] 终于解决了它们的感染问题，并决定出售多余的果冻。</li>
    <!--EN: root->[FACTION_name] looted the insectoid caves and will sell the jelly on the market.-->
    <li>root-&gt;[FACTION_name]洗劫了昆虫洞穴并将果冻放在市场上出售。</li>
    <!--EN: root->[FACTION_name] got a hold of a large supply of insect jelly and plans to sell it.-->
    <li>root-&gt;[FACTION_name]掌握了大量昆虫果冻并计划出售。</li>
  </VTE_FactionInfestationLoot.rulePack.rulesStrings>
  <VTE_FactionSiegePlan.rulePack.rulesStrings>
    <!--EN: root->[FACTION_name] plans for a number of siege operations and began stockpiling ammo and weapons.-->
    <li>root-&gt;[FACTION_name]计划进行多次围攻行动并开始储存弹药和武器。</li>
    <!--EN: root->[FACTION_name] is preparing for war and will stockpile ammo and weapons.-->
    <li>root-&gt;[FACTION_name]正在为战争做准备，并将储存弹药和武器。</li>
    <!--EN: root->[FACTION_name] buys excess amounts of weapons and mortar shells.-->
    <li>root-&gt;[FACTION_name] 购买过量的武器和迫击炮 炮弹。</li>
  </VTE_FactionSiegePlan.rulePack.rulesStrings>
  <VTE_FearOfBankruptcy.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] is rumored to announce bankruptcy. Share price can either crash or skyrocket.-->
    <li>据传 root-&gt;[COMPANY] 将宣布破产。股价可能会暴跌，也可能会飙升。</li>
  </VTE_FearOfBankruptcy.rulePack.rulesStrings>
  <VTE_GoodEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a good earnings report. Price is expected to move slightly up.-->
    <li>root-&gt;[COMPANY] 发布了一份不错的收益报告。预计价格将小幅上涨。</li>
  </VTE_GoodEarnings.rulePack.rulesStrings>
  <VTE_GreatEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a great earnings report. Price is expected to move up.-->
    <li>root-&gt;[COMPANY] 发布了一份出色的收益报告。预计价格将上涨。</li>
  </VTE_GreatEarnings.rulePack.rulesStrings>
  <VTE_MediocreEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted a mediocre earnings report. Price is expected to move sideways.-->
    <li>root-&gt;[COMPANY] 发布了一份平庸的收益报告。预计价格将横盘整理。</li>
  </VTE_MediocreEarnings.rulePack.rulesStrings>
  <VTE_NewShipPurchased.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has purchased a brand new low orbit trading ship. Share price should go up in the long term.-->
    <li>root-&gt;[COMPANY]购买了一艘全新的低轨道贸易船。从长远来看，股价应该会上涨。</li>
  </VTE_NewShipPurchased.rulePack.rulesStrings>
  <VTE_OutstandingEarnings.rulePack.rulesStrings>
    <!--EN: root->[COMPANY] has posted an outstanding earnings report. Price is expected to skyrocket.-->
    <li>root-&gt;[COMPANY] 发布了一份出色的收益报告。预计价格将飙升。</li>
  </VTE_OutstandingEarnings.rulePack.rulesStrings>
  <VTE_SettlementAlphabeavers.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] is struggling with a pack of alphabeavers, and purchases a large quantity of wood.-->
    <li>root-&gt;[SETTLEMENT_label] 正在与一群海狸斗争，并购买了大量木材。</li>
    <!--EN: root->[SETTLEMENT_label] ran out of wood and will buy it in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 木材用完了，将批量购买。</li>
    <!--EN: root->[SETTLEMENT_label] requires copious amounts of wood for their project.-->
    <li>root-&gt;[SETTLEMENT_label] 的项目需要大量木材。</li>
  </VTE_SettlementAlphabeavers.rulePack.rulesStrings>
  <VTE_SettlementAlphabeaversDealtWith.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has gotten rid of the beaver pack that troubled them, and now sell excess wood.-->
    <li>root-&gt;[SETTLEMENT_label] 已经摆脱了困扰他们的海狸群，现在出售多余的木材。</li>
    <!--EN: root->[SETTLEMENT_label] sells their excess wood.-->
    <li>root-&gt;[SETTLEMENT_label] 出售多余的木材。</li>
    <!--EN: root->[SETTLEMENT_label] cut down a large chunk of the forest with the intent to sell wood.-->
    <li>root-&gt;[SETTLEMENT_label]为了出售木材而砍伐了大片森林。</li>
  </VTE_SettlementAlphabeaversDealtWith.rulePack.rulesStrings>
  <VTE_SettlementApparelPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of apparel.-->
    <li>root-&gt;[SETTLEMENT_label] 获得大量服装。</li>
  </VTE_SettlementApparelPurchase.rulePack.rulesStrings>
  <VTE_SettlementApparelSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of apparel.-->
    <li>root-&gt;[SETTLEMENT_label] 销售大量服装。</li>
  </VTE_SettlementApparelSellOff.rulePack.rulesStrings>
  <VTE_SettlementArmorPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of armor.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量护甲。</li>
  </VTE_SettlementArmorPurchase.rulePack.rulesStrings>
  <VTE_SettlementArmorSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of armor.-->
    <li>root-&gt;[SETTLEMENT_label] 出售大量护甲。</li>
  </VTE_SettlementArmorSellOff.rulePack.rulesStrings>
  <VTE_SettlementBigHarvest.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has had an amazing harvest and sells off their food supplies.-->
    <li>root-&gt;[SETTLEMENT_label] 获得了惊人的收成并出售了他们的粮食供应。</li>
    <!--EN: root->[SETTLEMENT_label] plans to sell large quantities of food.-->
    <li>root-&gt;[SETTLEMENT_label] 计划出售大量食品。</li>
    <!--EN: root->[SETTLEMENT_label] has had a fortunate harvest and will sell the excess food.-->
    <li>root-&gt;[SETTLEMENT_label] 收获颇丰，将出售多余的粮食。</li>
  </VTE_SettlementBigHarvest.rulePack.rulesStrings>
  <VTE_SettlementBlight.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has suffered a terrible blight and buys off large quantities of food.-->
    <li>root-&gt;[SETTLEMENT_label]遭受了严重的枯萎病并购买了大量食物。</li>
    <!--EN: root->[SETTLEMENT_label] has had their food stockpile burn down.-->
    <li>root-&gt;[SETTLEMENT_label] 的粮食储备已被烧毁。</li>
    <!--EN: root->[SETTLEMENT_label] plans to purchase large quantity of food.-->
    <li>root-&gt;[SETTLEMENT_label]计划购买大量食物。</li>
  </VTE_SettlementBlight.rulePack.rulesStrings>
  <VTE_SettlementBodyPartsPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of body parts.-->
    <li>root-&gt;[SETTLEMENT_label] 获取大量身体部位。</li>
  </VTE_SettlementBodyPartsPurchase.rulePack.rulesStrings>
  <VTE_SettlementBodyPartsSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of body parts.-->
    <li>root-&gt;[SETTLEMENT_label] 出售大量身体部位。</li>
  </VTE_SettlementBodyPartsSellOff.rulePack.rulesStrings>
  <VTE_SettlementColdSnap.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has been struck with coldsnap, ruining their food supply.-->
    <li>root-&gt;[SETTLEMENT_label]遭受寒流袭击，破坏了他们的食物供应。</li>
    <!--EN: root->[SETTLEMENT_label] has lost their food supply.-->
    <li>root-&gt;[SETTLEMENT_label] 失去了食物供应。</li>
    <!--EN: root->[SETTLEMENT_label] buys food in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 批量购买食物。</li>
  </VTE_SettlementColdSnap.rulePack.rulesStrings>
  <VTE_SettlementCombatEmergency.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] buys off large amounts of weapons due to an emergency.-->
    <li>root-&gt;[SETTLEMENT_label]因紧急情况购买了大量武器。</li>
    <!--EN: root->[SETTLEMENT_label] prepares to go to war and will purchase weapons.-->
    <li>root-&gt;[SETTLEMENT_label]准备参战并将购买武器。</li>
    <!--EN: root->[SETTLEMENT_label] requires a large amount of weapons quite urgently. Prices are expected to go up.-->
    <li>root-&gt;[SETTLEMENT_label]非常迫切地需要大量武器。预计价格将会上涨。</li>
  </VTE_SettlementCombatEmergency.rulePack.rulesStrings>
  <VTE_SettlementDrugsPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of drugs.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量药物。</li>
  </VTE_SettlementDrugsPurchase.rulePack.rulesStrings>
  <VTE_SettlementDrugsSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of drugs.-->
    <li>root-&gt;[SETTLEMENT_label] 销售大量 毒品。</li>
  </VTE_SettlementDrugsSellOff.rulePack.rulesStrings>
  <VTE_SettlementGotPlague.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] is struggling with a plague. Medicine purchasing frenzy began.-->
    <li>root-&gt;[SETTLEMENT_label]正在与瘟疫作斗争。药品采购狂潮开始了。</li>
    <!--EN: root->[SETTLEMENT_label] is recovering after a raid. Medicine will be purchased in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 正在袭击后恢复。药品将批量购买。</li>
    <!--EN: root->[SETTLEMENT_label] is in dire need of medicine, which means the price will go up.-->
    <li>root-&gt;[SETTLEMENT_label]急需药品，这意味着价格将会上涨。</li>
  </VTE_SettlementGotPlague.rulePack.rulesStrings>
  <VTE_SettlementGotRaided.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] was recently raided. Rebuilding is underway.-->
    <li>root-&gt;[SETTLEMENT_label] 最近遭到袭击。重建工作正在进行中。</li>
    <!--EN: root->[SETTLEMENT_label] suffered a natural disaster and will purchase building materials.-->
    <li>root-&gt;[SETTLEMENT_label]遭受自然灾害，将购买建筑材料。</li>
    <!--EN: root->[SETTLEMENT_label] plans to expand, but will require building materials to do so.-->
    <li>root-&gt;[SETTLEMENT_label] 计划扩建，但需要建筑材料。</li>
  </VTE_SettlementGotRaided.rulePack.rulesStrings>
  <VTE_SettlementHeatWave.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has suffered a terrible heat wave and decided to sell off their food before it rots.-->
    <li>root-&gt;[SETTLEMENT_label] 遭受了可怕的热浪，决定在食物腐烂之前卖掉它们。</li>
    <!--EN: root->[SETTLEMENT_label] has had a freezer malfunction and sells food before it rots.-->
    <li>root-&gt;[SETTLEMENT_label] 冰箱出现故障，并在食物腐烂之前出售食物。</li>
    <!--EN: root->[SETTLEMENT_label] sells their food stockpile.-->
    <li>root-&gt;[SETTLEMENT_label] 出售他们的粮食库存。</li>
  </VTE_SettlementHeatWave.rulePack.rulesStrings>
  <VTE_SettlementLeatherPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of leathers.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量皮革。</li>
    <!--EN: root->[SETTLEMENT_label] buys leathers in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 批量购买皮革。</li>
    <!--EN: root->[SETTLEMENT_label] acquires copious amounts of various leathers.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量各种皮革。</li>
  </VTE_SettlementLeatherPurchase.rulePack.rulesStrings>
  <VTE_SettlementLeatherSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of leathers.-->
    <li>root-&gt;[SETTLEMENT_label] 出售大量皮革。</li>
  </VTE_SettlementLeatherSellOff.rulePack.rulesStrings>
  <VTE_SettlementManhunterMeat.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells off large quantities of meat they obtained from a manhunter pack.-->
    <li>root-&gt;[SETTLEMENT_label] 出售他们从猎人群体中获得的大量肉。</li>
    <!--EN: root->[SETTLEMENT_label] had a very bountiful hunting trip and will sell excess meat.-->
    <li>root-&gt;[SETTLEMENT_label] 度过了一次非常丰富的狩猎之旅，并将出售多余的肉。</li>
    <!--EN: root->[SETTLEMENT_label] no longer requires their meat and will soon flood the market with it.-->
    <li>root-&gt;[SETTLEMENT_label]不再需要它们的肉，并且很快就会充斥市场。</li>
  </VTE_SettlementManhunterMeat.rulePack.rulesStrings>
  <VTE_SettlementMechanoidShipsSalvaged.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has dealt with Defoliator ships and now sell excess plasteel.-->
    <li>root-&gt;[SETTLEMENT_label] 已处理除叶者飞船，现在出售多余的塑料。</li>
    <!--EN: root->[SETTLEMENT_label] has mined a large amount of plasteel and plans to sell it.-->
    <li>root-&gt;[SETTLEMENT_label] 开采了大量的塑钢并计划出售。</li>
    <!--EN: root->[SETTLEMENT_label] sells unused plasteel.-->
    <li>root-&gt;[SETTLEMENT_label] 出售未使用的塑料钢。</li>
  </VTE_SettlementMechanoidShipsSalvaged.rulePack.rulesStrings>
  <VTE_SettlementPlagueDealtWith.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] dealt with their plague and now sells excess medicine.-->
    <li>root-&gt;[SETTLEMENT_label] 解决了他们的瘟疫，现在出售多余的药品。</li>
    <!--EN: root->[SETTLEMENT_label] sells off excess medicine.-->
    <li>root-&gt;[SETTLEMENT_label] 出售多余的药品。</li>
    <!--EN: root->[SETTLEMENT_label] no longer has any need for their medicine stockpiles.-->
    <li>root-&gt;[SETTLEMENT_label]不再需要他们的药品库存。</li>
  </VTE_SettlementPlagueDealtWith.rulePack.rulesStrings>
  <VTE_SettlementPowerArmorUpgrade.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] has decided to upgrade their defenses with a new set of powered armors. They buy Plasteel in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 决定用一套新的动力装甲升级他们的防御。他们批量购买 Plasteel。</li>
    <!--EN: root->[SETTLEMENT_label] requires plasteel and plans to buy a lot of it in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 需要塑料钢并计划大量购买。</li>
    <!--EN: root->[SETTLEMENT_label] improves their defenses and plans to obtain plasteel, steel and components.-->
    <li>root-&gt;[SETTLEMENT_label] 提高了防御能力并计划获取塑料、钢材和部件。</li>
  </VTE_SettlementPowerArmorUpgrade.rulePack.rulesStrings>
  <VTE_SettlementPrisonBreak.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] had a prison break. They promise to step up the security.-->
    <li>root-&gt;[SETTLEMENT_label] 越狱。他们承诺加强安全措施。</li>
    <!--EN: root->[SETTLEMENT_label] is stockpiling weapons.-->
    <li>root-&gt;[SETTLEMENT_label]正在储存武器。</li>
    <!--EN: root->[SETTLEMENT_label] plans to equip everyone with new weapons.-->
    <li>root-&gt;[SETTLEMENT_label] 计划为每个人配备新武器。</li>
  </VTE_SettlementPrisonBreak.rulePack.rulesStrings>
  <VTE_SettlementPrisonBreakDealtWith.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] had a prison break which failed dramatically. They decided to sell excess weaponry and armor.-->
    <li>root-&gt;[SETTLEMENT_label] 的越狱行动戏剧性地失败了。他们决定出售多余的武器和盔甲。</li>
    <!--EN: root->[SETTLEMENT_label] decided not to go to war. They will sell their weapons and armors.-->
    <li>root-&gt;[SETTLEMENT_label]决定不参战。他们将出售他们的武器和盔甲。</li>
    <!--EN: root->[SETTLEMENT_label] will sell their old weapons and armors.-->
    <li>root-&gt;[SETTLEMENT_label]将出售他们的旧武器和盔甲。</li>
  </VTE_SettlementPrisonBreakDealtWith.rulePack.rulesStrings>
  <VTE_SettlementRecentRaidSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] was recently raided. Looters sell off whatever they stole.-->
    <li>root-&gt;[SETTLEMENT_label] 最近遭到袭击。抢劫者变卖了他们偷来的一切。</li>
    <!--EN: root->[SETTLEMENT_label] scavenged a lot of useful junk and will soon flood the market with it.-->
    <li>root-&gt;[SETTLEMENT_label] 清除了大量有用的垃圾，并将很快充斥市场。</li>
    <!--EN: root->[SETTLEMENT_label] plans to empty the stockpiles.-->
    <li>root-&gt;[SETTLEMENT_label] 计划清空库存。</li>
  </VTE_SettlementRecentRaidSellOff.rulePack.rulesStrings>
  <VTE_SettlementStoneBlocksPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of stone blocks.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量石块。</li>
  </VTE_SettlementStoneBlocksPurchase.rulePack.rulesStrings>
  <VTE_SettlementStoneBlocksSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of stone blocks.-->
    <li>root-&gt;[SETTLEMENT_label]出售大量石块。</li>
  </VTE_SettlementStoneBlocksSellOff.rulePack.rulesStrings>
  <VTE_SettlementTechprintsPurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of techprints.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量技术印刷品。</li>
  </VTE_SettlementTechprintsPurchase.rulePack.rulesStrings>
  <VTE_SettlementTechprintsSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of techprints.-->
    <li>root-&gt;[SETTLEMENT_label] 出售大量技术印刷品。</li>
  </VTE_SettlementTechprintsSellOff.rulePack.rulesStrings>
  <VTE_SettlementTextilePurchase.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] acquires a large amount of textiles.-->
    <li>root-&gt;[SETTLEMENT_label]获得大量纺织品。</li>
    <!--EN: root->[SETTLEMENT_label] plans to supply their tailors with copious amounts of textiles.-->
    <li>root-&gt;[SETTLEMENT_label] 计划为其裁缝提供大量纺织品。</li>
    <!--EN: root->[SETTLEMENT_label] buys textiles in bulk.-->
    <li>root-&gt;[SETTLEMENT_label] 批量购买纺织品。</li>
  </VTE_SettlementTextilePurchase.rulePack.rulesStrings>
  <VTE_SettlementTextileSellOff.rulePack.rulesStrings>
    <!--EN: root->[SETTLEMENT_label] sells a large amount of textiles.-->
    <li>root-&gt;[SETTLEMENT_label] 销售大量纺织品。</li>
  </VTE_SettlementTextileSellOff.rulePack.rulesStrings>
