<?xml version='1.0' encoding='UTF-8'?>
<LanguageData>
  <!--EN: Awaken dryads-->
  <VDE_Awaken>觉醒树精</VDE_Awaken>
  <!--EN: Turn three dryads of a type into an awakened version that is free from the trees. This new awakened dryad will act as a normal animal of the colony in most aspects.-->
  <VDE_AwakenDesc>将三只同种类的树精融合成不受灵枢仙树束缚的觉醒树精。觉醒树精的基本习性与普通动物较为相似，战斗型的觉醒树精可以被征召。</VDE_AwakenDesc>
  <!--EN: Gaubric production-->
  <VDE_GaubricDesc>树精绒绸产出进度</VDE_GaubricDesc>
  <!--EN: Neutroamine production-->
  <VDE_NeutroamineDesc>中性胺产出进度</VDE_NeutroamineDesc>
  <!--EN: Awakening in {0}-->
  <VDE_TicksToSpawn>{0}后觉醒</VDE_TicksToSpawn>
  <!--EN: Convert to Ambrosia Palm-->
  <VDE_TurnIntoPalm>转化成仙馐灵树</VDE_TurnIntoPalm>
  <!--EN: Evolves the dryad into an ambrosia palm that produces the drug periodically-->
  <VDE_TurnIntoPalmDesc>将觉醒甘馐树精转化成能够定期结出仙馐果的仙馐灵树。</VDE_TurnIntoPalmDesc>
</LanguageData>
