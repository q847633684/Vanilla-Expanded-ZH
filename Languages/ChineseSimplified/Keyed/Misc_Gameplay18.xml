<?xml version='1.0' encoding='UTF-8'?>
<LanguageData>
  <!--EN: Awaken dryads-->
  <VDE_Awaken>唤醒树妖</VDE_Awaken>
  <!--EN: Turn three dryads of a type into an awakened version that is free from the trees. This new awakened dryad will act as a normal animal of the colony in most aspects.-->
  <VDE_AwakenDesc>将同一类型的三个树妖转变为脱离树木的觉醒版本。这个新觉醒的树妖在大多数方面都将像殖民地的正常动物一样。</VDE_AwakenDesc>
  <!--EN: Gaubric production-->
  <VDE_GaubricDesc>粗布生产</VDE_GaubricDesc>
  <!--EN: Neutroamine production-->
  <VDE_NeutroamineDesc>中性胺生产</VDE_NeutroamineDesc>
  <!--EN: Awakening in {0}-->
  <VDE_TicksToSpawn>在{0}中觉醒</VDE_TicksToSpawn>
  <!--EN: Convert to Ambrosia Palm-->
  <VDE_TurnIntoPalm>转换为 仙草棕榈</VDE_TurnIntoPalm>
  <!--EN: Evolves the dryad into an ambrosia palm that produces the drug periodically-->
  <VDE_TurnIntoPalmDesc>将树妖进化成仙草棕榈，定期生产药物</VDE_TurnIntoPalmDesc>
</LanguageData>
