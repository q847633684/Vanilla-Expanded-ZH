<LanguageData>
  <!--EN: Body clock-->
  <NocturnalAnimals.BodyClock>生物钟</NocturnalAnimals.BodyClock>
  <!--EN: Crepuscular-->
  <NocturnalAnimals.BodyClock_Crepuscular>暮</NocturnalAnimals.BodyClock_Crepuscular>
  <!--EN: Determines when the animal sleeps and when it is awake.\n\nDiurnal animals sleep during the night and are awake during the day, while nocturnal animals sleep during the day and are awake during the night. Crepuscular animals are mainly active during dusk.-->
  <NocturnalAnimals.BodyClock_Description>确定动物何时睡觉以及何时醒着。

昼行性动物在夜间睡觉并在白天醒来，而夜行性动物则在白天睡觉并在夜间醒来。黄昏动物主要在黄昏时活动。</NocturnalAnimals.BodyClock_Description>
  <!--EN: Diurnal-->
  <NocturnalAnimals.BodyClock_Diurnal>昼夜</NocturnalAnimals.BodyClock_Diurnal>
  <!--EN: Nocturnal-->
  <NocturnalAnimals.BodyClock_Nocturnal>夜</NocturnalAnimals.BodyClock_Nocturnal>
  <!--EN: These animal behaviours options will affect all animal mods that share code from the Vanilla Expanded Framework-->
  <VCE_AffectsAllAnimalMods>这些动物行为选项将影响所有共享原版扩展框架代码的动物模组</VCE_AffectsAllAnimalMods>
  <!--EN: Allow animal particles (gas and filth)-->
  <VCE_AnimalParticlesOption>允许动物颗粒（气体和污物）</VCE_AnimalParticlesOption>
  <!--EN: Allow asexual reproduction-->
  <VCE_AsexualReproductionOption>允许无性繁殖</VCE_AsexualReproductionOption>
  <!--EN: Allow "blink" mechanics (for example, Skiphounds)-->
  <VCE_BlinkMechanicsOption>允许“闪烁”机制（例如，Skiphounds）</VCE_BlinkMechanicsOption>
  <!--EN: Allow animals building things (for example, beavers building dams)-->
  <VCE_BuildPeriodicallyOption>允许动物建造东西（例如，海狸建造水坝）</VCE_BuildPeriodicallyOption>
  <!--EN: Allow animals recharging nearby batteries or refueling-->
  <VCE_ChargeBatteriesOption>允许动物在附近的电池充电或加油</VCE_ChargeBatteriesOption>
  <!--EN: Allow corpse decaying mechanics (for example, Helixien slug's effect)-->
  <VCE_CorpseDecayingEffectOption>允许尸体腐烂机制（例如Helixien slug的效果）</VCE_CorpseDecayingEffectOption>
  <!--EN: Allows animals digging for things periodically-->
  <VCE_DigPeriodicallyOption>允许动物定期挖掘东西</VCE_DigPeriodicallyOption>
  <!--EN: Allow digging when hungry mechanics (for example, Frostmites digging corpses)-->
  <VCE_DigWhenHungryOption>允许机械师在饥饿时挖掘（例如，霜螨挖掘尸体）</VCE_DigWhenHungryOption>
  <!--EN: Allows animals causing hediffs, mental states or thoughts-->
  <VCE_EffecterOption>允许动物引起头晕、精神状态或想法</VCE_EffecterOption>
  <!--EN: Allow animals' eggs that explode (such as dragons')-->
  <VCE_ExplodingEggsOption>允许动物的蛋爆炸（例如龙的蛋）</VCE_ExplodingEggsOption>
  <!--EN: Allow animals changing graphics (for example, Chameleon Yak)-->
  <VCE_GraphicChangingOption>允许动物改变图形（例如变色龙牦牛）</VCE_GraphicChangingOption>
  <!--EN: Allow animals "hovering", ignoring terrain movement costs and waterstriding-->
  <VCE_HoveringOption>允许动物“悬停”，忽略地形移动成本和水跨</VCE_HoveringOption>
  <!--EN: Allow health regeneration (active and passive)-->
  <VCE_RegenerationOption>允许健康恢复（主动和被动）</VCE_RegenerationOption>
  <!--EN: Allow animals to auto-resurrect (for example Phoenix Owlcat)-->
  <VCE_ResurrectionOption>允许动物自动复活（例如凤凰猫头鹰）</VCE_ResurrectionOption>
  <!--EN: Allow some animals to be untameable-->
  <VCE_UntameableOption>允许一些动物无法驯服</VCE_UntameableOption>
