以下是针对 **全部网络设备（LSW1、AR1、AC1、AC2）** 的终极优化配置脚本，涵盖 **安全性增强、性能调优、高可用性设计** 及 **自动化运维** 策略：

---

### **一、LSW1交换机优化配置**
```plaintext
system-view
sysname LSW1-ACC-Floor2  # 标准化命名（接入层/2楼）
vlan batch 100 200
stp mode mstp  # 多生成树协议
stp region-configuration
 region-name NetworkZone1
 instance 1 vlan 100
 instance 2 vlan 200
 active region-configuration
quit

# 上行端口（连接核心）
interface Eth-Trunk1
 description LACP-TO-CORE
 mode lacp-static
 trunkport GigabitEthernet 0/0/24
 port link-type trunk
 port trunk pvid vlan 999  # Native VLAN隔离
 port trunk allow-pass vlan 100 200
 storm-control all min-rate 1000
 qos trust dscp
 quit

# 用户接入端口（安全增强）
interface range GigabitEthernet 0/0/1 to 0/0/23
 port link-type access
 port default vlan 100
 port-security enable
 port-security max-mac-num 1
 port-security mac-address sticky
 port-security protect-action shutdown  # 违规直接关闭端口
 authentication open
 dot1x re-authenticate
 quit

# 动态路由保护（防止伪造路由）
ip route-static 0.0.0.0 0.0.0.0 172.16.10.1 tag 100  # 管理流量默认路由
route-policy AntiSpoof deny
 if-match ip-prefix blackhole
 apply cost +1000  # 无效路由标记高开销
quit
```

---

### **二、核心路由器（AR1）终极优化**
```plaintext
system-view
sysname CORE-RTR-MAIN  # 核心路由器-主节点
vlan batch 200 400 600 999

# 接口安全与负载均衡
interface Eth-Trunk10
 description LACP-TO-AC1
 mode lacp-static
 trunkport GigabitEthernet 8/0/0
 port link-type trunk
 port trunk allow-pass vlan 200
 qos schedule-profile HighPriority  # 定义流量调度模板
 quit

# 高级路由策略
ip ip-prefix CriticalService index 10 permit 192.168.11.0 24  # 定义关键业务网段
route-policy CorePolicy permit node 10
 if-match ip-prefix CriticalService
 apply preference 10  # 关键业务路由优先级最高
 quit
bgp 65001
 peer 172.16.11.1 as-number 65001  # 与AC1建立iBGP邻居
 network 192.168.11.0 255.255.255.0
 quit

# 抗DDoS攻击
cpu-defend policy AntiDDoS
 car all 512  # 限制所有协议报文速率
 tcp-syn rate-limit 1000  # SYN Flood防护
 quit
```

