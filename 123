### **三、主无线控制器（AC1）终极优化**
```plaintext
system-view
sysname AC1-WLC-MAIN
vlan batch 100 200

# 无线服务增强
wlan
 radio-profile name HighDensity  # 高密度场景优化
  channel 149  # 5GHz非DFS信道
  air-scan disable  # 关闭空口扫描提升性能
  quit
 vap-profile name Employee-VAP
  forward-mode direct  # 直连转发（需AP支持本地交换）
  service-vlan vlan-id 200
  security-profile WLAN-Secure
  ssid-profile Corp-Net
  quit

# 智能射频管理
ap-group name HighDensity-APs
 radio-profile HighDensity radio all
 calibrate enable  # 自动信道校准
 quit

# 基于角色的访问控制（RBAC）
aaa
 manager-user admin
 password cipher Admin@2023!
 service-type ssh
 level 15
 authorization-scheme RoleBased
  user-role network-admin  # 分权分域
 quit
```

