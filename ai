let SpeechRuleJS = {
    name: "ai朗读规则（整合多角色）",
    id: "ttsrv.multi_voice",
    author: "TTS Server",
    version: 7,
    zdfp: 0, // 0: 不自动分配角色, 1: 自动分配
    tags: {
        narration: { name: "旁白", emotion: "neutral" },
        dialogue: { name: "对话🗣️", emotion: "neutral" },
        heroine: { name: "① 女性主角👸🏻", value: roleValues.heroine, emotion: "positive" },
        actorprotagonist: { name: "② 男性主角🤴🏻", value: roleValues.actorprotagonist, emotion: "firm" },
        girl: { name: "③ 女性少年👧🏻", value: roleValues.girl, emotion: "calm" },
        boy: { name: "④ 男性少年👦🏻", value: roleValues.boy, emotion: "lively" },
        seniorfemale: { name: "⑤ 女性老年👵🏻", value: roleValues.seniorfemale, emotion: "gentle" },
        seniormale: { name: "⑥ 男性老年👴🏻", value: roleValues.seniormale, emotion: "calm" },
        youngadultfemale: { name: "⑦ 女性青年👩🏻", value: roleValues.youngadultfemale, emotion: "positive" },
        youngadultmale: { name: "⑧ 男性青年👨🏻", value: roleValues.youngadultmale, emotion: "neutral" },
        olderadultfemale: { name: "⑨ 女性中年🤵🏻‍♀️", value: roleValues.olderadultfemale, emotion: "calm" },
        olderadultmale: { name: "⑩ 男性中年🤵🏻‍♂️", value: roleValues.olderadultmale, emotion: "firm" }
    },

    // 分割长句（从非AI规则整合）
    splitText(text) {
        if (typeof text !== "string") {
            console.error("splitText: 输入不是字符串，转换为字符串", text);
            text = String(text);
        }
        let separatorStr = "。？!；";
        let list = [];
        let tmpStr = "";
        text.split("").forEach((char, index) => {
            tmpStr += char;
            if (separatorStr.includes(char)) {
                list.push(tmpStr);
                tmpStr = "";
            } else if (index === text.length - 1) {
                list.push(tmpStr);
            }
        });
        return list.filter(item => item.replace(/[“”]/g, "").trim().length > 0);
    },

    // 获取所有角色名（从非AI规则整合）
    getAllRoleStr() {
        let allrole = [];
        for (let roleIdx in this.tags) {
            if (roleIdx === "narration" || roleIdx === "dialogue" || !this.tags[roleIdx].value) continue;
            let tmpRoleValue = String(this.tags[roleIdx].value).replace(/\n/g, "");
            if (tmpRoleValue) {
                let tmpRoles = tmpRoleValue.split("|");
                tmpRoles.forEach(role => {
                    if (!allrole.includes(role)) allrole.push(role);
                });
            }
        }
        return allrole.join("|");
    },

    // 正则匹配角色（从非AI规则整合）
    getMatchRegexFlag(roleValue, allroleStr, regexStr, str) {
        if (typeof roleValue !== "string" || typeof regexStr !== "string" || typeof str !== "string") {
            console.error("getMatchRegexFlag: 输入参数类型错误", { roleValue, regexStr, str });
            return false;
        }
        let tmpRoleValue = roleValue.replace(/\n/g, "");
        if (!tmpRoleValue) return false;
        let tmpRegexStr = regexStr.replace(/__ROLE__/g, tmpRoleValue);
        if (allroleStr) {
            tmpRegexStr = tmpRegexStr.replace(/__ALLROLE__/g, allroleStr);
        }
        console.log("正则表达式:", tmpRegexStr);
        try {
            return new RegExp(tmpRegexStr, "u").test(str);
        } catch (e) {
            console.error("正则表达式错误:", e);
            return false;
        }
    },

    // 获取默认对话的TTS ID（从非AI规则整合）
    getDefaultVoiceID(defaultVoice) {
        let voiceIDs = [];
        for (let idx in defaultVoice) {
            if (defaultVoice[idx].value !== "false") {
                voiceIDs.push(defaultVoice[idx]);
            }
        }
        if (voiceIDs.length === 0) return -1;
        if (voiceIDs.length === 1) return voiceIDs[0].id;
        if (randomOrInOrder === 1) {
            return voiceIDs[Math.floor(Math.random() * voiceIDs.length)].id;
        }
        if (randomOrInOrder === 2) {
            let a = 0;
            if (historicalDialogueIdList.length > 0) {
                for (let i = 0; i < voiceIDs.length - 1; i++) {
                    if (historicalDialogueIdList[historicalDialogueIdList.length - 1] === voiceIDs[i].id) {
                        a = i + 1;
                    }
                }
                if (randomOrFixed === 1 && a === 0) {
                    return voiceIDs[Math.floor(Math.random() * voiceIDs.length)].id;
                }
            }
            return voiceIDs[a].id;
        }
        return -1;
    },

    // 处理文本
    handleText(text, patientFeedback = {}) {
        if (typeof text !== "string") {
            console.error("handleText: 输入不是字符串，转换为字符串", text);
            text = String(text);
        }
        console.log("输入文本:", text);
        let list = [];
        if (patientFeedback.actionCompleted) {
            list.push({ text: "很好，继续保持！", tag: "dialogue", emotion: "positive" });
        }
        text = this.splitText(text);
        historicalTextList = historicalTextList.concat(text);
        let reverseMap = {};
        let allroleStr = this.getAllRoleStr();
        Object.keys(this.tags).forEach(key => {
            if (key === "narration" || key === "dialogue") return;
            const names = this.tags[key].value.split("|");
            names.forEach(name => reverseMap[name] = key);
        });

        let lastDialogueTag = historicalDialogueIdList.length > 0 ? historicalDialogueIdList[historicalDialogueIdList.length - 1] : null;
        let secondLastDialogueTag = historicalDialogueIdList.length > 1 ? historicalDialogueIdList[historicalDialogueIdList.length - 2] : null;

        text.forEach((tmpStr, index) => {
            tmpStr = tmpStr.trim();
            if (!tmpStr) return;
            let endTag = "narration";
            let emotion = "neutral";
            if (tmpStr[0] === "“") {
                let js = tmpStr.match(/【(.*?)】/) || [];
                if (js.length > 1) {
                    endTag = reverseMap[js[1]] || "dialogue";
                    tmpStr = tmpStr.replace(/【.*?】/, "");
                } else {
                    endTag = "dialogue";
                    // 动态对话角色分配（从非AI规则整合）
                    if (DiaRule === 1 && lastDialogueTag) {
                        endTag = lastDialogueTag;
                    } else if (DiaRule === 2 && secondLastDialogueTag) {
                        endTag = secondLastDialogueTag;
                    } else if (DiaRule === 3) {
                        let roleKeys = Object.keys(this.tags).filter(k => k !== "narration" && k !== "dialogue");
                        endTag = roleKeys[Math.floor(Math.random() * roleKeys.length)];
                    }
                }
                emotion = this.tags[endTag]?.emotion || "neutral";
                console.log("分配角色:", endTag, "情感:", emotion, "文本:", tmpStr);
            } else {
                // 旁白角色匹配
                for (let roleIdx in this.tags) {
                    if (roleIdx === "narration" || roleIdx === "dialogue") continue;
                    if (this.getMatchRegexFlag(this.tags[roleIdx].value, allroleStr, narrationFrontRegex, tmpStr) ||
                        this.getMatchRegexFlag(this.tags[roleIdx].value, allroleStr, narrationBackRegex, tmpStr)) {
                        endTag = roleIdx;
                        break;
                    }
                }
                emotion = this.tags[endTag].emotion;
            }
            list.push({ text: tmpStr, tag: endTag, emotion });
            if (endTag !== "narration") {
                secondLastDialogueTag = lastDialogueTag;
                lastDialogueTag = endTag;
                historicalDialogueIdList.push(endTag);
            }
        });
        console.log("输出列表:", list);
        // 修复 ClassCastException：返回 JSON 字符串
        return JSON.stringify(list);
    },

    // API调用（支持本地TTS fallback）
    post(textContent, emotion = "neutral") {
        if (typeof textContent !== "string") {
            console.error("post: 输入不是字符串，转换为字符串", textContent);
            textContent = String(textContent);
        }
        if (roleCache.has(textContent)) {
            return roleCache.get(textContent);
        }
        try {
            if (typeof ttsrv !== "undefined" && ttsrv.localTTSAvailable && ttsrv.localTTSAvailable()) {
                const result = ttsrv.localTTSProcess(textContent, { model: "ChatTTS", emotion });
                roleCache.set(textContent, result);
                return JSON.stringify(result); // 确保返回字符串
            }
            const encryptedText = AES.encrypt(textContent, 'secret-key').toString();
            const requestData = {
                model: "google/gemini-2.0-flash-exp:free",
                messages: [{ role: 'user', content: `分析对话角色：${encryptedText}，情感：${emotion}` }]
            };
            const headers = {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${API_KEY}`
            };
            const response = ttsrv.httpPost(
                'https://openrouter.ai/api/v1/chat/completions',
                JSON.stringify(requestData),
                headers
            );
            const result = JSON.parse(response.body().string()).choices[0]?.message?.content || { role: "narration" };
            roleCache.set(textContent, result);
            return JSON.stringify(result); // 确保返回字符串
        } catch (error) {
            console.error('API或本地TTS失败，使用默认角色:', error);
            return JSON.stringify({ role: "narration" });
        }
    },

    // 角色频率更新
    thhs(val, tet) {
        if (typeof val !== "string" || typeof tet !== "string") {
            console.error("thhs: 输入参数类型错误，转换为字符串", { val, tet });
            val = String(val);
            tet = String(tet);
        }
        val = val.replace(/[^:\d\[\u2E80-\u9FFF\]\n]/g, "");
        val = val.replace(/(\d+):([\u2E80-\u9FFF]+)/g, "【$1】:【$2】");
        let a = val.split("\n");
        try {
            for (let x of a) {
                let c = x.split(":") || [];
                if (c.length > 1) {
                    roleFrequencyCache.set(c[1], (roleFrequencyCache.get(c[1]) || 0) + 1);
                    tet = tet.replace(new RegExp(c[0], "g"), c[1]);
                }
            }
            ttsrv.writeTxtFileAsync("jss.json", JSON.stringify(Object.fromEntries(roleFrequencyCache)));
            return tet;
        } catch (e) {
            console.error("thhs 错误:", e);
            return tet;
        }
    },

    // 调试角色排序
    qjs() {
        let a2 = [];
        for (let [role, freq] of roleFrequencyCache) {
            a2.push([role, freq]);
        }
        a2.sort((a, b) => b[1] - a[1]);
        let iu = a2.map((x, i) => `juese${i}:"${x[0]}"`).join(",\n");
        console.log("角色排序:", iu);
        return iu; // 确保返回字符串
    }
};

SpeechRuleJS.qjs();